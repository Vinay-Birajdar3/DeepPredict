# DeepPredict Environment Configuration Example
# Copy this file to .env and adjust variables as needed

APP_ENV=development
LOG_LEVEL=INFO

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false

# Dashboard Configuration
DASHBOARD_PORT=8501

# Paths & Tracking
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
MODEL_DIR=./models
MLFLOW_TRACKING_URI=./mlruns

# Modeling Defaults
WINDOW_LENGTH=30
RUL_CAP=125
BATCH_SIZE=64
RANDOM_SEED=42

